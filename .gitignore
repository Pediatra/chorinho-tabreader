# ambiente
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# acervo de amostra e derivados pesados (B2: versiona-se o indice, nao o video)
parts/

# pesos treinados: vao para artefatos/, mas nao para o git
# (a PROCEDENCIA deles e versionada: artefatos/*.md)
artefatos/*
!artefatos/.gitkeep
!artefatos/*.md
*.pt
*.pth
*.safetensors

# saida de depuracao
/tmp/
*.log

# Saidas grandes: o que se versiona e o RESUMO e a MONTAGEM, nao o recorte cru.
# (Mesma politica dos pesos em artefatos/: dado bruto fica no disco, o indice fica no git.)
data/saida/simbolos/*/
data/saida/afinacao/*/
!data/saida/afinacao/_mosaicos/
data/saida/afinacao/_mosaicos/*/
data/saida/portao_casos/
data/saida/frames/_chk_*.png
# Folhas de leitura e zooms: pesados e REGENERAVEIS pelos comandos documentados
# (`tab.portao`/`tab.painel` geram as folhas; a rotulagem fica em data/gold/portao.json).
data/saida/frames/folha_*.png
data/saida/frames/zoom_*.png

# O resumo e os mosaicos da afinacao sao o INDICE (pequenos); os recortes 4x ficam fora.
!data/saida/afinacao/resumo.json
!data/saida/afinacao/_mosaicos/*.png

# Ouro de video: as imagens (telas/instantes) sao regeneraveis por `tab.ouro_video preparar`
# (semente fixa); versiona-se o pre.json, que e o indice e o pre-preenchimento.
data/saida/ouro_video/*/telas/
data/saida/ouro_video/*/instantes/

# Cache de quadros do censo (T-cache): regeneravel por `tab.censo --cache`; grande, nao versionar.
data/cache/

# artefatos gerados (visíveis no host, não versionados; o que já é rastreado continua rastreado)
data/saida/

# Gabaritos da partitura que NUNCA entram no git (AGENTS §9); cópia em .tar no arquivo frio
# (decisão 9001, §7c, item 2).
data/gold/partitura/compassos_homr.json
data/gold/partitura/figura_e1.json
