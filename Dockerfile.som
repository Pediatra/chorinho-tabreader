# Imagem PRÓPRIA da trilha áudio para o transcritor livre (rodada 2018, decisão 2005).
#
# Por que não deriva da base `chorinho:dev`: o Basic Pitch 0.4.0 (Spotify, Apache-2.0) não
# roda no Python 3.14 da base. No Linux com Python >= 3.11 ele exige tensorflow < 2.15.1; no
# 3.10 usa o tflite-runtime, pequeno. Por isso esta imagem parte do python:3.10-slim e só
# serve ao transcritor: ela não tem torch, cv2 nem o pacote do projeto instalado. O código
# vem do bind-mount; o módulo que roda aqui importa só stdlib, numpy e basic_pitch.
#
# Download aprovado pelo dono em 2026-10-21. Tamanho medido: base 127 MB, pacotes 499 MB.
#
# Como construir (SEM enviar o repositório como contexto: data/saida tem GBs):
#   podman build -t chorinho-som:dev - < Dockerfile.som
#
# Como rodar:
#   podman run --rm --security-opt label=disable \
#     -v /var/home/gabriel/Projects/chorinho-dataset:/app \
#     -v /run/media/gabriel/3014CD4714CD1130/chorinho_cache:/cache:ro \
#     -w /app -e PYTHONPATH=/app chorinho-som:dev python -m tab.audio_transcrever ...

FROM docker.io/library/python:3.10-slim@sha256:7b6bd969dda3ecfca0655524e338b57a8b8cd692a9362e3d55b5a3ef49b07256

# Versões exatas, as que o resolvedor escolheu para basic-pitch==0.4.0 em 2026-10-21, com
# uma troca: numpy 1.26.4 no lugar de 2.2.6. O tflite-runtime 2.14 foi compilado contra o
# numpy 1.x e, com o 2.x, não carrega o modelo (medido: SystemError no Interpreter).
RUN pip install --no-cache-dir --no-deps \
        basic-pitch==0.4.0 \
        tflite-runtime==2.14.0 \
        audioread==3.1.0 \
        certifi==2026.10.19 \
        cffi==2.1.1 \
        charset-normalizer==3.5.2 \
        cloudpickle==3.1.2 \
        decorator==5.3.1 \
        idna==3.20 \
        importlib_resources==7.1.0 \
        joblib==1.6.0 \
        lazy-loader==0.6 \
        librosa==0.11.0 \
        llvmlite==0.50.0 \
        mido==1.3.3 \
        mir_eval==0.8.2 \
        msgpack==1.2.3 \
        numba==0.68.0 \
        numpy==1.26.4 \
        packaging==26.3 \
        platformdirs==4.12.4 \
        pooch==1.9.0 \
        pretty_midi==0.2.11.post0 \
        pycparser==3.11 \
        requests==2.34.2 \
        resampy==0.4.2 \
        scikit-learn==1.7.2 \
        scipy==1.15.3 \
        six==1.17.0 \
        soundfile==0.14.0 \
        soxr==1.1.0 \
        threadpoolctl==3.7.0 \
        typing_extensions==4.16.0 \
        urllib3==2.8.0 \
    && pip check \
    && python -c "import numpy, tflite_runtime.interpreter as t; from basic_pitch import ICASSP_2022_MODEL_PATH as m; t.Interpreter(str(m)); print('modelo ok, numpy', numpy.__version__)"
