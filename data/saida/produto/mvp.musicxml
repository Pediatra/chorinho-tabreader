<score-partwise version="4.0"><movement-title>retrato brasileiro (MVP)</movement-title><identification><miscellaneous><miscellaneous-field name="ordem">telas em ordem de id (= ordem da primeira aparição no vídeo, que é a leitura da música); colunas por x dentro de cada tela</miscellaneous-field><miscellaneous-field name="repeticoes">cada tela entra UMA vez; as exibições repetidas pela aula ficam de fora</miscellaneous-field><miscellaneous-field name="compasso">barras da tela (barlines_x) limpas: barras a menos de 0,75 passo fundidas e haste lida como barra removida; a fórmula 2/4 é DECLARADA, não lida da tela</miscellaneous-field><miscellaneous-field name="duracao">NÃO medida: as colunas de cada compasso dividem os 2 tempos por igual; o ritmo real não sai do vídeo</miscellaneous-field><miscellaneous-field name="tempo">o tempo (t_ini) não entra neste arquivo; fica no JSON</miscellaneous-field><miscellaneous-field name="tonalidade">não lida: armadura zero assumida; alterações são escritas como sustenido</miscellaneous-field></miscellaneous></identification><part-list><score-part id="P1"><part-name>Guitarra (Tab)</part-name></score-part></part-list><part id="P1"><measure number="1"><attributes><divisions>1024</divisions><key><fifths>0</fifths></key><time><beats>2</beats><beat-type>4</beat-type></time><clef><sign>TAB</sign><line>5</line></clef><staff-details><staff-lines>6</staff-lines><staff-tuning line="1"><tuning-step>E</tuning-step><tuning-octave>4</tuning-octave></staff-tuning><staff-tuning line="2"><tuning-step>B</tuning-step><tuning-octave>3</tuning-octave></staff-tuning><staff-tuning line="3"><tuning-step>G</tuning-step><tuning-octave>3</tuning-octave></staff-tuning><staff-tuning line="4"><tuning-step>D</tuning-step><tuning-octave>3</tuning-octave></staff-tuning><staff-tuning line="5"><tuning-step>A</tuning-step><tuning-octave>2</tuning-octave></staff-tuning><staff-tuning line="6"><tuning-step>E</tuning-step><tuning-octave>2</tuning-octave></staff-tuning></staff