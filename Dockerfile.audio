# Imagem DERIVADA da base `chorinho:dev`, só para as figuras da trilha áudio (A1).
#
# Por que existe: as figuras precisam de matplotlib, e a base não pode mudar (o gate e o
# pipeline do projeto dependem dela, e matplotlib não entra no requirements.txt). Esta imagem
# acrescenta só matplotlib e as dependências dele, com versões exatas.
#
# Como construir (SEM enviar o repositório como contexto: data/saida tem GBs):
#   podman build -t chorinho-audio:dev - < Dockerfile.audio
#
# Como rodar (o código vem do bind-mount do repositório, como na base):
#   podman run --rm --security-opt label=disable \
#     -v /var/home/gabriel/Projects/chorinho-dataset:/app \
#     -v /run/media/gabriel/3014CD4714CD1130/chorinho:/acervo:ro \
#     -v /run/media/gabriel/3014CD4714CD1130/chorinho_cache:/cache \
#     -w /app -e PYTHONPATH=/app chorinho-audio:dev python -m tab.audio_figuras ...
#
# ATENÇÃO: esta imagem NÃO serve para outras trilhas se algo da base mudar. O build confere
# numpy, PIL, cv2 e torch antes e depois do pip, e falha se alguma versão mudar.

FROM docker.io/library/chorinho:dev

ENV MPLBACKEND=Agg

# Versões ANTES do pip (base). Ficam em /opt para o RUN seguinte comparar.
RUN python -c "import numpy, PIL, cv2, torch; print('numpy', numpy.__version__); print('PIL', PIL.__version__); print('cv2', cv2.__version__); print('torch', torch.__version__)" > /opt/versoes_antes.txt \
    && cat /opt/versoes_antes.txt

# matplotlib 3.11.2 tem wheel cp314 (manylinux x86_64). Instalado com --no-deps de propósito:
# sem isso o pip resolve numpy 2.5.4 e troca o numpy da base (2.5.2). As dependências são
# fixadas aqui à mão, na versão que o resolvedor escolheu no dry-run contra a base.
RUN pip install --no-cache-dir --no-deps \
        matplotlib==3.11.2 \
        contourpy==1.4.0 \
        cycler==0.12.1 \
        fonttools==4.66.1 \
        kiwisolver==1.5.1 \
        packaging==26.3 \
        pyparsing==3.3.3 \
        python-dateutil==2.9.0.post0 \
        six==1.17.0

# Versões DEPOIS do pip: têm de ser iguais às de antes. Se não forem, o build falha.
RUN python -c "import numpy, PIL, cv2, torch; print('numpy', numpy.__version__); print('PIL', PIL.__version__); print('cv2', cv2.__version__); print('torch', torch.__version__)" > /opt/versoes_depois.txt \
    && cat /opt/versoes_depois.txt \
    && diff /opt/versoes_antes.txt /opt/versoes_depois.txt \
    && python -c "import matplotlib; print('matplotlib', matplotlib.__version__, matplotlib.get_backend())"
